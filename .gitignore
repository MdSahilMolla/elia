# --- Dependencies ---
node_modules/
# npm lockfile — this is a bun project, bun.lock is authoritative
package-lock.json

# --- Editor / AI-assistant tooling (local, per-machine) ---
.agents/
.claude/
.cursor/
.devin/

# --- Secrets ---
# Only .env.example is committed; every real env file stays local.
.env
.env.*
!.env.example

# --- Logs and scratch output ---
*.log
*.tmp
tsconfig.tsbuildinfo

# --- elia's own runtime state ---
.elia/
# Runtime SQLite databases belong under .elia/; never commit one at the repo root.
*.db
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
# Sandboxes, backups, and the ledger from `elia evolve` — elia's own working area.
.evolution/

# --- Build output ---
dist/
extensions/vscode/dist/
extensions/vscode/*.vsix

# --- Rust (crates/, native addon) ---
/target/
**/*.rs.bk

# --- Go (go/elia-index sidecar, local build) ---
go/bin/

# --- JVM (jvm/elia-jvm-bridge) ---
jvm/**/build/
*.class

# --- Codebase-analysis tool artifacts (`ua` / understand) ---
.ua/

# --- Language/tooling caches ---
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- PowerShell's $null leaking into a shell that treats it as a filename ---
# `cmd > $null` is only a discard in PowerShell; run the same line under sh or
# cmd.exe and the redirect creates an empty file literally named `$null` in the
# working directory. It is never wanted, and an untracked one in the root has
# already been swept into a commit by a `git add -A`.
/$null

# --- Archived pre-v2 source, kept for reference only ---
legacy/

# --- Local-only analysis notes ---
gap.md
lacking/
docs/
research/

# --- Scratch workspace: elia builds throwaway projects here ---
/workspace/
/static-site/
meat-awareness/
/kerala-navigator/
/adamas-university-site/

# --- Playwright MCP browser-tool session logs and page snapshots ---
.playwright-mcp/
