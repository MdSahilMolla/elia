# Which provider to use: anthropic (default) | groq | openai | google | nvidia | mercury | custom
ELIA_PROVIDER=anthropic

# Recommended for installed CLI users: `elia config set --provider <name>` stores
# the key in ~/.elia/config.env without echoing it or putting it in project files.
# Set the key for whichever provider you're using:
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=
INCEPTION_API_KEY=

# For "custom" (any other OpenAI-compatible operator: Together, Fireworks,
# local Ollama/vLLM/LM Studio, etc.) set these instead:
# ELIA_PROVIDER=custom
# ELIA_API_KEY=
# ELIA_BASE_URL=https://your-provider.example.com/v1
# ELIA_MODEL=your-model-id

# Supervision is the default for interactive autonomous work. Set this explicitly
# to prevent accidental policy drift in a deployment; unattended remains opt-in.
# ELIA_SUPERVISION=supervised

# Optional overrides (work for any provider):
# ELIA_MODEL=claude-sonnet-5
# ELIA_BASE_URL=
# ELIA_ROUTING_MODE=auto       # selected (default) or auto provider failover

# --- Optional fast tier -----------------------------------------------------
# Elia splits work across two models: a "deep" tier that plans, builds, and
# reviews, and a "fast" tier for the high-volume legwork (read-only scouts,
# summarising, end-of-run note taking). Configure a cheap fast model here and
# investigation gets several times quicker at a fraction of the cost, while every
# decision still goes through the strong model. Leave it unset and both tiers are
# the same model — behaviour is identical, you just don't get the speed-up.
# ELIA_FAST_PROVIDER=groq
# ELIA_FAST_MODEL=openai/gpt-oss-20b
# ELIA_FAST_API_KEY=          # optional; falls back to the provider's own key var
# ELIA_FAST_BASE_URL=         # optional; only for a custom fast endpoint
# ELIA_TOOL_CONCURRENCY=4     # read-only tool batches may use up to 8; mutating batches stay capped at 4
# Optional true multi-model role routes. Any unset role uses its fast/deep tier.
# ELIA_SCOUT_PROVIDER=groq
# ELIA_SCOUT_MODEL=openai/gpt-oss-20b
# ELIA_CRITIC_PROVIDER=anthropic
# ELIA_CRITIC_MODEL=claude-sonnet-5
# Optional dev-mode-only declarative tool hooks. Prefer .elia/dev-hooks.json for project rules.
# ELIA_DEV_HOOKS=[{"id":"prefer-rg","tool":"run_command","inputContains":"grep ","message":"Use rg instead of grep for repository searches."}]

# Set to "off" to ignore the tools elia has written for itself in ~/.elia/skills.
# ELIA_SKILLS=off
# Optional operator-selected shared skill directories, separated by ':' on Unix or ';' on Windows.
# External skills have lower precedence than user and project skills.
# ELIA_SKILL_DIRS=/home/shared/elia-skills:/home/team/agent-skills

# Optional deployment credentials and site/project identifiers. Values are read by the provider CLI
# and never included in Elia receipts. Link the project locally before deployment.
# VERCEL_TOKEN=
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=

# --- Multi-agent (elia agent) ------------------------------------------------
# The Marketing and Finance personas use web_search for real external research.
# Configure at least one supported search provider. Without a key, web_search
# fails with setup instructions instead of silently returning nothing.
ELIA_SEARCH_PROVIDER=auto
EXA_API_KEY=
SERPER_API_KEY=
ELIA_SEARCH_API_KEY=       # Brave Search fallback

# --- Browser automation -------------------------------------------------------
# Optional. Use a trusted local bridge that accepts one JSON request per stdin
# line and returns one JSON or text response per invocation. Keep browser
# credentials in the bridge environment, never in this file or in prompts.
# ELIA_BROWSER_BRIDGE_COMMAND=
# Optional direct connector route when an enabled user-browser MCP server is available.
# ELIA_BROWSER_MCP_SERVER=My Browser
# Override individual default names such as browser_navigate when the connector uses different tool names.
# ELIA_BROWSER_NAVIGATE_TOOL=browser_navigate
# Optional alternative: a Chrome DevTools HTTP endpoint (for example a local
# debugging port) or a ws:// target URL. This controls that browser only.
# ELIA_BROWSER_CDP_URL=

# --- Communication workflows --------------------------------------------------
# Drafts are always available locally under .elia/communications/. Sending and
# delivery verification require one trusted adapter. The adapter receives one
# JSON request per invocation and should return one JSON or text response.
# ELIA_COMMUNICATION_BRIDGE_COMMAND=
# Or use an enabled communication MCP server; override tool names when needed.
# ELIA_COMMUNICATION_MCP_SERVER=
# ELIA_COMMUNICATION_SEND_TOOL=communication_send
# ELIA_COMMUNICATION_VERIFY_TOOL=communication_verify
