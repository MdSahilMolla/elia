{
  "name": "elia",
  "version": "0.1.0",
  "description": "A fast, autonomous coding agent for the terminal, with pluggable LLM providers.",
  "private": false,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "elia": "./bin/elia.ts"
  },
  "files": [
    "bin",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "homepage": "https://github.com/MdSahilMolla/elia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MdSahilMolla/elia.git"
  },
  "bugs": {
    "url": "https://github.com/MdSahilMolla/elia/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "dev": "bun run bin/elia.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test"
  },
  "keywords": [
    "ai",
    "agent",
    "autonomous-agent",
    "coding-agent",
    "cli",
    "bun",
    "llm",
    "nvidia-nim"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "openai": "^7.5.0",
    "pptxgenjs": "^4.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "7"
  }
}
