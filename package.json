{
  "name": "elia-ai",
  "version": "0.1.7",
  "description": "A fast, autonomous coding agent for the terminal, with pluggable LLM providers.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "files": [
    "bin",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "src/**/*.js",
    "src/**/*.cjs",
    "src/vendor/PPTXGENJS-LICENSE.txt",
    ".env.example",
    "tsconfig.json"
  ],
  "overrides": {
    "uuid": "11.1.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "homepage": "https://github.com/MdSahilMolla/elia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MdSahilMolla/elia.git"
  },
  "bugs": {
    "url": "https://github.com/MdSahilMolla/elia/issues"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "elia": "bin/elia.ts",
    "elia-mcp": "./src/mcp/server.ts"
  },
  "scripts": {
    "dev": "bun run bin/elia.ts",
    "mcp": "bun run src/mcp/server.ts",
    "mcp:http": "bun run src/mcp/server.ts --transport http",
    "mcp:smoke": "bun run scripts/mcp-run-task-smoke.ts",
    "react": "bun run src/react_server.ts",
    "test": "bun test --timeout=20000",
    "test:parallel": "bun test --timeout=20000 --parallel",
    "test:fast": "bun test --timeout=20000 --path-ignore-patterns 'src/battmann/**' --path-ignore-patterns 'src/ui/app/fastRender.test.ts' --path-ignore-patterns 'src/ui/cliSmoke.test.ts' --path-ignore-patterns 'src/sourceHygiene.test.ts' --path-ignore-patterns 'src/bridgeHttp.test.ts' --path-ignore-patterns 'src/vscodeBridge.test.ts' --path-ignore-patterns 'src/vscodeBridgeProtocol.test.ts' --path-ignore-patterns 'src/evolve/hypothesisBrief.test.ts' --path-ignore-patterns 'src/tools/causalDebug.test.ts' --path-ignore-patterns 'src/tools/communication.test.ts' --path-ignore-patterns 'src/tools/environment.test.ts'",
    "test:slow": "bun test --timeout=120000 src/battmann/ src/ui/app/fastRender.test.ts src/ui/cliSmoke.test.ts src/sourceHygiene.test.ts src/bridgeHttp.test.ts src/vscodeBridge.test.ts src/vscodeBridgeProtocol.test.ts src/evolve/hypothesisBrief.test.ts src/tools/causalDebug.test.ts src/tools/communication.test.ts src/tools/environment.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ bin/ scripts/",
    "security:scan": "bun run scripts/security-scan.ts",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run test && bun run security:scan"
  },
  "keywords": [
    "ai",
    "agent",
    "autonomous-agent",
    "coding-agent",
    "cli",
    "bun",
    "llm",
    "nvidia-nim"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "diff": "^9.0.0",
    "exceljs": "^4.4.0",
    "ink": "^7.1.1",
    "jszip": "^3.10.1",
    "openai": "^7.5.0",
    "react": "^19.2.8",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "7",
    "web-tree-sitter": "0.22.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/cors": "^2.8.19",
    "@types/react": "^19.2.18",
    "cors": "^2.8.6",
    "ink-testing-library": "^4.0.0",
    "oxlint": "1.83.0",
    "pptxgenjs": "4.0.1",
    "react-dom": "^19.3.0"
  }
}
